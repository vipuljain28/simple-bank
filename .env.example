DATABASE_URL=postgresql+psycopg://simple_bank:replace-with-local-password@localhost:5432/simple_bank
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SESSION_COOKIE_NAME=simple_bank_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_IDLE_TIMEOUT_SECONDS=300
SESSION_MAX_AGE_SECONDS=3600

# Minimum account balance required across all account types (default: Rs 1000.00)
MIN_BALANCE_SAVINGS=1000.00
